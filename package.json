{
  "name": "recipe-clipper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Save the recipe on the current page as a Cooklang .cook file.",
  "license": "MIT",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "jsdom": "^31.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5"
  },
  "dependencies": {
    "@cooklang/cooklang-import": "file:../cooklang-import-wasm/wasm"
  }
}
